#!/usr/bin/python3
"""
ietf-hardware-state-matter

Reports Matter sensor devices (e.g. IKEA ALPSTUGA, Matter over Thread) as RFC 8348
ietf-hardware-state XML. The readings are taken from the Open Home Foundation
Matter Server (python-matter-server, the controller used by Home Assistant /
Nabu Casa) over its WebSocket API. The Matter Server talks to the Thread devices
through an OpenThread Border Router (e.g. a Home Assistant Connect ZBT-2 dongle).

Only the Python standard library is used so the script runs unchanged on any
Linux host with python3 (no pip/apt dependencies).

Usage:
  ietf-hardware-state-matter [get]          print <hardware> XML (used by netconfd)
  ietf-hardware-state-matter nodes          list commissioned Matter nodes
  ietf-hardware-state-matter commission <pairing-code> [<pairing-code> ...]
                                            commission devices (sets the Thread
                                            dataset from OTBR first if needed)
  ietf-hardware-state-matter thread-dataset [<hex-dataset>]
                                            show/set the Thread operational dataset
                                            known to the Matter Server

When installed as 'ietf-hardware-state-get' (symlink) the default subcommand
is 'get'.

Environment:
  MATTER_SERVER_URL       ws://localhost:5580/ws   Matter Server WebSocket URL
  MATTER_NODE_ID          (unset)                  only report this Matter node id;
                                                   use one netconfd instance per device
  MATTER_TIMEOUT          5                        seconds, WebSocket request timeout
  OTBR_REST_URL           http://localhost:8081    OTBR REST API, used to fetch the
                                                   active Thread dataset when commissioning
  THREAD_DATASET          (unset)                  hex TLV dataset, overrides OTBR_REST_URL
"""

import base64
import json
import os
import socket
import ssl
import struct
import sys
import time
import urllib.parse
import urllib.request
from xml.sax.saxutils import escape

MATTER_SERVER_URL = os.environ.get("MATTER_SERVER_URL", "ws://localhost:5580/ws")
OTBR_REST_URL = os.environ.get("OTBR_REST_URL", "http://localhost:8081")
TIMEOUT = float(os.environ.get("MATTER_TIMEOUT", "5"))

NS_HW = "urn:ietf:params:xml:ns:yang:ietf-hardware-state"
NS_IANAHW = "urn:ietf:params:xml:ns:yang:iana-hardware"

# Matter cluster / attribute ids (Matter Application Cluster Specification)
CL_BASIC_INFORMATION = 40       # 0x0028
CL_POWER_SOURCE = 47            # 0x002F
CL_AIR_QUALITY = 91             # 0x005B
CL_TEMPERATURE = 1026           # 0x0402
CL_RELATIVE_HUMIDITY = 1029     # 0x0405
CL_CO2 = 1037                   # 0x040D
CL_CO = 1036                    # 0x040C
CL_NO2 = 1043                   # 0x0413
CL_OZONE = 1045                 # 0x0415
CL_PM25 = 1066                  # 0x042A
CL_FORMALDEHYDE = 1067          # 0x042B
CL_PM1 = 1068                   # 0x042C
CL_PM10 = 1069                  # 0x042D
CL_TVOC = 1070                  # 0x042E
CL_RADON = 1071                 # 0x042F

ATTR_MEASURED_VALUE = 0
ATTR_MEASUREMENT_UNIT = 8       # concentration measurement clusters
ATTR_BAT_PERCENT_REMAINING = 12 # power source cluster (0x0C), in half percent

BASIC_VENDOR_NAME = 1
BASIC_VENDOR_ID = 2
BASIC_PRODUCT_NAME = 3
BASIC_PRODUCT_ID = 4
BASIC_NODE_LABEL = 5
BASIC_HARDWARE_VERSION_STRING = 8
BASIC_SOFTWARE_VERSION_STRING = 10
BASIC_SERIAL_NUMBER = 15
BASIC_UNIQUE_ID = 18

# MeasurementUnitEnum of the concentration measurement clusters
MEASUREMENT_UNITS = {0: "ppm", 1: "ppb", 2: "ppt", 3: "mg/m3", 4: "ug/m3",
                     5: "ng/m3", 6: "particles/m3", 7: "Bq/m3"}

# AirQualityEnum
AIR_QUALITY = {0: "unknown", 1: "good", 2: "fair", 3: "moderate", 4: "poor",
               5: "very poor", 6: "extremely poor"}

# Concentration clusters: (component name suffix, units-display label)
CONCENTRATION_CLUSTERS = {
    CL_CO2: ("co2", "CO2"),
    CL_CO: ("co", "CO"),
    CL_NO2: ("no2", "NO2"),
    CL_OZONE: ("ozone", "O3"),
    CL_PM1: ("pm1", "PM1"),
    CL_PM25: ("pm25", "PM2.5"),
    CL_PM10: ("pm10", "PM10"),
    CL_FORMALDEHYDE: ("formaldehyde", "CH2O"),
    CL_TVOC: ("tvoc", "TVOC"),
    CL_RADON: ("radon", "Radon"),
}

SENSOR_CLUSTERS = set(CONCENTRATION_CLUSTERS) | {
    CL_TEMPERATURE, CL_RELATIVE_HUMIDITY, CL_AIR_QUALITY, CL_POWER_SOURCE}


# ---------------------------------------------------------------------------
# Minimal RFC 6455 WebSocket client (text frames only, no external modules)
# ---------------------------------------------------------------------------

class WebSocket:
    def __init__(self, url, timeout=TIMEOUT):
        u = urllib.parse.urlsplit(url)
        if u.scheme not in ("ws", "wss"):
            raise ValueError("unsupported URL scheme: %s" % url)
        host = u.hostname
        port = u.port or (443 if u.scheme == "wss" else 80)
        path = (u.path or "/") + (("?" + u.query) if u.query else "")
        self.sock = socket.create_connection((host, port), timeout=timeout)
        if u.scheme == "wss":
            self.sock = ssl.create_default_context().wrap_socket(
                self.sock, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode()
        hostport = host if port in (80, 443) else "%s:%d" % (host, port)
        req = ("GET %s HTTP/1.1\r\n"
               "Host: %s\r\n"
               "Upgrade: websocket\r\n"
               "Connection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\n"
               "Sec-WebSocket-Version: 13\r\n"
               "\r\n") % (path, hostport, key)
        self.sock.sendall(req.encode())
        self.buf = b""
        while b"\r\n\r\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("connection closed during handshake")
            self.buf += chunk
        header, self.buf = self.buf.split(b"\r\n\r\n", 1)
        status = header.split(b"\r\n", 1)[0]
        if b" 101 " not in status:
            raise ConnectionError("WebSocket handshake failed: %s" %
                                  status.decode(errors="replace"))

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("connection closed")
            self.buf += chunk
        data, self.buf = self.buf[:n], self.buf[n:]
        return data

    def send(self, text):
        payload = text.encode()
        mask = os.urandom(4)
        hdr = bytes([0x81])             # FIN + text
        n = len(payload)
        if n < 126:
            hdr += bytes([0x80 | n])
        elif n < 65536:
            hdr += bytes([0x80 | 126]) + struct.pack("!H", n)
        else:
            hdr += bytes([0x80 | 127]) + struct.pack("!Q", n)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(hdr + mask + masked)

    def recv(self):
        """Return the next complete text message (handles fragmentation and
        control frames)."""
        message = b""
        while True:
            b0, b1 = self._read(2)
            fin = b0 & 0x80
            opcode = b0 & 0x0F
            masked = b1 & 0x80
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack("!H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack("!Q", self._read(8))[0]
            mask = self._read(4) if masked else None
            payload = self._read(n)
            if mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:            # close
                raise ConnectionError("WebSocket closed by server")
            if opcode == 0x9:            # ping -> pong
                self._send_control(0xA, payload)
                continue
            if opcode == 0xA:            # pong
                continue
            message += payload
            if fin:
                return message.decode()

    def _send_control(self, opcode, payload=b""):
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes([0x80 | opcode, 0x80 | len(payload)]) + mask + masked)

    def close(self):
        try:
            self._send_control(0x8, struct.pack("!H", 1000))
        except OSError:
            pass
        self.sock.close()


# ---------------------------------------------------------------------------
# Matter Server client
# ---------------------------------------------------------------------------

class MatterServerError(Exception):
    pass


class MatterServer:
    def __init__(self, url=MATTER_SERVER_URL, timeout=TIMEOUT):
        self.ws = WebSocket(url, timeout)
        # the server announces itself first
        self.info = json.loads(self.ws.recv())
        self._id = 0

    def close(self):
        self.ws.close()

    def command(self, command, timeout=None, **args):
        self._id += 1
        msg_id = str(self._id)
        self.ws.send(json.dumps({"message_id": msg_id, "command": command,
                                 "args": args}))
        if timeout is not None:
            self.ws.sock.settimeout(timeout)
        while True:
            msg = json.loads(self.ws.recv())
            if msg.get("message_id") != msg_id:
                continue                 # events etc.
            if "error_code" in msg:
                raise MatterServerError("%s failed: %s (error %s)" % (
                    command, msg.get("details"), msg.get("error_code")))
            return msg.get("result")

    def get_nodes(self):
        return self.command("get_nodes") or []


# ---------------------------------------------------------------------------
# Node helpers
# ---------------------------------------------------------------------------

def attr(node, endpoint, cluster, attribute, default=None):
    return node.get("attributes", {}).get("%d/%d/%d" % (endpoint, cluster, attribute), default)


def endpoints_with_cluster(node, cluster):
    """Sorted endpoint ids on which the cluster has at least one attribute."""
    eps = set()
    for path in node.get("attributes", {}):
        try:
            ep, cl, _ = path.split("/")
        except ValueError:
            continue
        if int(cl) == cluster:
            eps.add(int(ep))
    return sorted(eps)


def has_sensor_clusters(node):
    return any(endpoints_with_cluster(node, cl) for cl in SENSOR_CLUSTERS)


def basic(node, attribute, default=""):
    v = attr(node, 0, CL_BASIC_INFORMATION, attribute)
    return default if v is None else str(v)


def component_name(node):
    product = basic(node, BASIC_PRODUCT_NAME)
    base = "".join(c if c.isalnum() else "-" for c in product.split()[0].lower()) if product else ""
    base = base.strip("-") or "matter-node"
    return "%s-%d" % (base, node["node_id"])


def select_nodes(nodes):
    node_id = os.environ.get("MATTER_NODE_ID")
    if node_id:
        wanted = int(node_id, 0)
        return [n for n in nodes if n["node_id"] == wanted]
    return [n for n in nodes if has_sensor_clusters(n)]


def timestamp_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# ---------------------------------------------------------------------------
# XML generation
# ---------------------------------------------------------------------------

def leaf(tag, value):
    return "<%s>%s</%s>" % (tag, escape(str(value)), tag) if value not in (None, "") else ""


def sensor_xml(name, parent, available, value, value_type, value_scale,
               units_display, timestamp, precision=2):
    out = ["<component>", leaf("name", name), "<class>ianahw:sensor</class>",
           leaf("parent", parent), "<sensor-data>"]
    if available and value is not None:
        out += [leaf("value", int(value)), leaf("value-type", value_type),
                leaf("value-scale", value_scale), leaf("value-precision", precision),
                "<oper-status>ok</oper-status>", leaf("units-display", units_display),
                leaf("value-timestamp", timestamp), "<value-update-rate>0</value-update-rate>"]
    else:
        out += [leaf("value-type", value_type), leaf("value-scale", value_scale),
                leaf("value-precision", precision),
                "<oper-status>unavailable</oper-status>",
                leaf("units-display", units_display),
                "<value-update-rate>0</value-update-rate>"]
    out += ["</sensor-data>", "</component>"]
    return "".join(out)


def node_xml(node, timestamp):
    name = component_name(node)
    available = bool(node.get("available"))
    label = basic(node, BASIC_NODE_LABEL)
    desc = "Matter node %d" % node["node_id"]
    if label:
        desc += " (%s)" % label
    if not available:
        desc += ", offline"
    out = ["<component>", leaf("name", name), "<class>ianahw:container</class>",
           leaf("description", desc),
           leaf("hardware-rev", basic(node, BASIC_HARDWARE_VERSION_STRING)),
           leaf("software-rev", basic(node, BASIC_SOFTWARE_VERSION_STRING)),
           # SerialNumber is optional in Matter, fall back to the UniqueID
           leaf("serial-num", basic(node, BASIC_SERIAL_NUMBER) or basic(node, BASIC_UNIQUE_ID)),
           leaf("mfg-name", basic(node, BASIC_VENDOR_NAME)),
           leaf("model-name", basic(node, BASIC_PRODUCT_NAME)),
           "</component>"]

    def suffix(base, eps, ep):
        # append the endpoint id when the same cluster appears on several endpoints
        return "%s-%s" % (name, base) if len(eps) == 1 else "%s-%s-ep%d" % (name, base, ep)

    # Temperature: 0.01 degC -> milli degC
    eps = endpoints_with_cluster(node, CL_TEMPERATURE)
    for ep in eps:
        v = attr(node, ep, CL_TEMPERATURE, ATTR_MEASURED_VALUE)
        out.append(sensor_xml(suffix("temperature", eps, ep), name, available,
                              None if v is None else v * 10, "celsius", "milli",
                              "milli degrees", timestamp))
    # Relative humidity: 0.01 %RH -> milli %RH
    eps = endpoints_with_cluster(node, CL_RELATIVE_HUMIDITY)
    for ep in eps:
        v = attr(node, ep, CL_RELATIVE_HUMIDITY, ATTR_MEASURED_VALUE)
        out.append(sensor_xml(suffix("humidity", eps, ep), name, available,
                              None if v is None else v * 10, "percent-RH", "milli",
                              "milli percent RH", timestamp))
    # Concentration clusters: float in MeasurementUnit -> x1000, value-scale milli
    for cluster, (base, label) in CONCENTRATION_CLUSTERS.items():
        eps = endpoints_with_cluster(node, cluster)
        for ep in eps:
            v = attr(node, ep, cluster, ATTR_MEASURED_VALUE)
            unit = MEASUREMENT_UNITS.get(attr(node, ep, cluster, ATTR_MEASUREMENT_UNIT), "")
            out.append(sensor_xml(suffix(base, eps, ep), name, available,
                                  None if v is None else round(v * 1000), "other", "milli",
                                  ("%s %s" % (label, unit)).strip(), timestamp))
    # Air quality index: AirQualityEnum, reported as is
    eps = endpoints_with_cluster(node, CL_AIR_QUALITY)
    for ep in eps:
        v = attr(node, ep, CL_AIR_QUALITY, ATTR_MEASURED_VALUE)
        out.append(sensor_xml(suffix("air-quality", eps, ep), name, available,
                              v, "other", "units",
                              "AirQualityEnum 0=unknown 1=good 2=fair 3=moderate "
                              "4=poor 5=very poor 6=extremely poor", timestamp, 0))
    # Battery, if the device reports one: half percent -> milli percent
    eps = endpoints_with_cluster(node, CL_POWER_SOURCE)
    for ep in eps:
        key = "%d/%d/%d" % (ep, CL_POWER_SOURCE, ATTR_BAT_PERCENT_REMAINING)
        if key not in node.get("attributes", {}):
            continue            # power source without battery (mains/USB powered)
        v = node["attributes"][key]
        out.append(sensor_xml(suffix("battery", eps, ep), name, available,
                              None if v is None else v * 500, "other", "milli",
                              "milli percent battery", timestamp))
    return "".join(out)


def hardware_xml(nodes, last_change):
    timestamp = timestamp_now()
    out = ['<hardware xmlns="%s" xmlns:ianahw="%s">' % (NS_HW, NS_IANAHW),
           leaf("last-change", last_change)]
    for node in sorted(nodes, key=lambda n: n["node_id"]):
        out.append(node_xml(node, timestamp))
    out.append("</hardware>")
    return "".join(out)


def last_change_of(nodes):
    """Newest commissioning time of the reported nodes, as the /hardware/last-change."""
    stamps = [n.get("date_commissioned") for n in nodes if n.get("date_commissioned")]
    if not stamps:
        return timestamp_now()
    s = max(stamps)
    # the server sends ISO 8601; normalise to the YANG date-and-time format
    if s.endswith("+00:00"):
        s = s[:-6] + "Z"
    return s


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

def cmd_get(argv):
    try:
        server = MatterServer()
        try:
            nodes = select_nodes(server.get_nodes())
        finally:
            server.close()
    except (OSError, ValueError, MatterServerError) as e:
        # the netconfd module expects <hardware> on stdout in all cases
        sys.stderr.write("ietf-hardware-state-matter: %s: %s\n" % (MATTER_SERVER_URL, e))
        nodes = []
    print(hardware_xml(nodes, last_change_of(nodes)))
    return 0


def cmd_nodes(argv):
    server = MatterServer()
    try:
        nodes = server.get_nodes()
    finally:
        server.close()
    print("Matter Server %s: fabric %s, sdk %s, thread credentials set: %s, bluetooth: %s" % (
        MATTER_SERVER_URL, server.info.get("fabric_id"), server.info.get("sdk_version"),
        server.info.get("thread_credentials_set"), server.info.get("bluetooth_enabled")))
    for n in sorted(nodes, key=lambda n: n["node_id"]):
        clusters = sorted(cl for cl in SENSOR_CLUSTERS if endpoints_with_cluster(n, cl))
        print("node %-4d %-10s %s %s %s serial=%s %s%s" % (
            n["node_id"], "online" if n.get("available") else "offline",
            basic(n, BASIC_VENDOR_NAME, "?"), basic(n, BASIC_PRODUCT_NAME, "?"),
            "(%s)" % basic(n, BASIC_NODE_LABEL) if basic(n, BASIC_NODE_LABEL) else "",
            basic(n, BASIC_SERIAL_NUMBER, "?"),
            "component=%s " % component_name(n) if clusters else "",
            "clusters=%s" % ",".join("0x%04X" % c for c in clusters) if clusters else "no sensor clusters"))
    return 0


def otbr_active_dataset():
    """Fetch the active Thread operational dataset (hex TLVs) from the OTBR REST API."""
    req = urllib.request.Request(OTBR_REST_URL.rstrip("/") + "/node/dataset/active",
                                 headers={"Accept": "text/plain"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read().decode().strip().strip('"')


def cmd_thread_dataset(argv):
    server = MatterServer()
    try:
        if argv:
            server.command("set_thread_dataset", dataset=argv[0])
            print("Thread dataset set")
        else:
            print("thread credentials set: %s" % server.info.get("thread_credentials_set"))
    finally:
        server.close()
    return 0


def cmd_commission(argv):
    if not argv:
        sys.stderr.write("usage: ietf-hardware-state-matter commission <pairing-code> [...]\n"
                         "  pairing-code: the MT:... QR payload or the 11/21 digit manual code\n")
        return 2
    server = MatterServer()
    try:
        if not server.info.get("thread_credentials_set"):
            dataset = os.environ.get("THREAD_DATASET")
            if not dataset:
                print("Fetching active Thread dataset from %s" % OTBR_REST_URL)
                dataset = otbr_active_dataset()
            server.command("set_thread_dataset", dataset=dataset)
            print("Thread dataset set on the Matter Server")
        if not server.info.get("bluetooth_enabled"):
            print("warning: Matter Server has no bluetooth adapter, new Thread devices can only\n"
                  "         be commissioned over BLE (start matter-server with --bluetooth-adapter 0)")
        rc = 0
        for code in argv:
            print("Commissioning %s ..." % code)
            try:
                # commissioning over BLE + Thread takes a while
                node = server.command("commission_with_code", timeout=180, code=code)
                print("  commissioned as node %s (%s %s), component %s" % (
                    node["node_id"], basic(node, BASIC_VENDOR_NAME, "?"),
                    basic(node, BASIC_PRODUCT_NAME, "?"), component_name(node)))
            except MatterServerError as e:
                rc = 1
                print("  failed: %s" % e)
        return rc
    finally:
        server.close()


COMMANDS = {"get": cmd_get, "nodes": cmd_nodes, "commission": cmd_commission,
            "thread-dataset": cmd_thread_dataset}


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv and argv[0] in COMMANDS:
        try:
            return COMMANDS[argv[0]](argv[1:])
        except (OSError, ValueError, MatterServerError) as e:
            sys.stderr.write("ietf-hardware-state-matter %s: %s\n" % (argv[0], e))
            return 1
    if argv:
        sys.stderr.write("unknown subcommand %r, see --help\n" % argv[0])
        return 2
    return cmd_get([])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
